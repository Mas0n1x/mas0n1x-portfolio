# Mas0n1x Portfolio — Environment-Variablen (Vorlage)
# Kopiere diese Datei nach .env und trage echte Werte ein.

# Port des Express-Backends (Standard: 3000)
PORT=3000

# GitHub Personal Access Token (Scope: repo + read:org).
# Wird für die öffentliche Projektliste UND die Hero-Statistiken genutzt.
GITHUB_TOKEN=

# Bot-Zentrale: URL des Homelab-Dashboards, das die zentrale Bot-Runtime hostet.
# Das Portfolio schickt Ereignisse an ${BOT_HUB_URL}/api/bots/portfolio/events.
BOT_HUB_URL=

# Geteiltes Bot-Runtime-Token für die Bot-Zentrale (Bearer-Auth).
# Fehlt BOT_HUB_URL oder BOT_HUB_TOKEN, werden Discord-Benachrichtigungen still übersprungen.
BOT_HUB_TOKEN=

# Optional: feste Basis-URL für Links in E-Mails (sonst aus dem Request abgeleitet).
BASE_URL=

# Optional: Persistente Geheimnisse. Werden sonst automatisch im data-Volume erzeugt.
SESSION_SECRET=
SECRETS_KEY=
